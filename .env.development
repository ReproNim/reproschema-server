# Development environment configuration
NODE_ENV=development
DEV_MODE=1
DEBUG_MODE=true

# Container settings
CONTAINER_NAME=reproschema-server-dev
PORT=3000

# Schema configuration
SCHEMA_SOURCE=https://raw.githubusercontent.com/ReproNim/demo-protocol/main/DemoProtocol/DemoProtocol_schema
SCHEMA_PATH=./schemas

# Data storage
DATA_PATH=./data
PROJECT_NAME=development

# Security (development only - change in production!)
JWT_SECRET_KEY=development-secret-key-change-in-production
INITIAL_TOKEN=development-token-change-in-production
ENV=development

# Backend settings
REPROSCHEMA_BACKEND_BASEDIR=/data
BACKEND_URL=/api

# UI settings
BANNER=ReproSchema Development
START_BUTTON=Start Assessment
STUDY_PREFIX=study

# Development features
ADMIN_MODE=true
VALIDATE_SCHEMA=true
SCHEMA_TYPE=jsonld
ASSETS_PUBLIC_PATH=/